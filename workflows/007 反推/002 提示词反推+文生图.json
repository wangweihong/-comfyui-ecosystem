:[{"dir":3,"localized_name":"source","name":"source","type":"*","link":153}],"outputs":[],"properties":{"cnr_id":"rgthree-comfy","ver":"1.0.2511270846","Node name for S&R":"Display Any (rgthree)","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.5.1"}},"widgets_values":["{\n  \"subject\": \"一位年轻女性，拥有齐肩棕色短发，面容精致，眼神温柔略带沉思，正坐在一个现代感的座椅上。她身穿一件露肩的黑白豹纹针织连衣裙，材质柔软有纹理，袖口和裙摆为纯色罗纹针织，展现出时尚与慵懒的结合。她的姿态放松，双腿交叠，双手自然放在膝盖上，头部微微侧倾，目光直视镜头，表情平静中带着一丝若有所思。\",\n  \"foreground\": \"前景是座椅边缘的蓝色织物纹理，质感细腻，与人物的针织裙形成色彩和材质对比，同时在画面下方有轻微的景深虚化，增强画面的层次感。\",\n  \"midground\": \"主体坐在一个现代简约风格的室内环境中，座椅设计线条流畅，背景有几何感的彩色装饰板（橙、黄、绿、红渐变），暗示这是一个充满艺术气息或创意空间的场所，如艺术工作室、现代咖啡馆或设计展厅。\",\n  \"background\": \"背景中隐约可见灰蓝色的墙面和金属质感的结构，远处有模糊的彩色光斑和几何装饰，营造出一种未来感与艺术感交织的氛围，但保持背景虚化，确保焦点集中在人物身上。\",\n  \"composition\": \"采用中景构图，人物位于画面中心偏左，符合三分法构图原则。镜头略微俯视，形成柔和的视觉引导，同时利用前景座椅边缘的线条引导视线聚焦于人物。整体画面具有景深层次，前景清晰，中景主体突出，背景虚化。\",\n  \"visual_guidance\": \"观众视线首先被前景座椅的蓝色织物吸引，随后自然过渡到人物面部和服装细节，最终聚焦于她直视镜头的眼神。服装的黑白豹纹图案与背景的彩色渐变形成视觉对比，增强画面的视觉张力。人物的侧脸与目光方向引导观众产生情感共鸣。\",\n  \"color_tone\": \"柔和的现代艺术色调，以灰蓝、黑白为主调，点缀橙黄、红色的渐变背景，营造出冷静、时尚且富有活力的视觉氛围。整体色彩饱和度适中，突出人物的优雅气质。\",\n  \"lighting_mood\": \"柔和的自然光从左上方照射，形成微妙的面部轮廓光，同时在服装纹理上产生细腻的光影层次。整体氛围宁静、温暖且略带梦幻感，光线均匀柔和，无强烈阴影，适合表现人物的温柔与沉思情绪。\",\n  \"caption\": \"一位身穿黑白豹纹针织连衣裙的年轻女性，坐在现代艺术风格的蓝色座椅上，背景是渐变彩色几何装饰墙，柔和的自然光勾勒出她的轮廓，她目光直视镜头，神情宁静而略带沉思，整体画面构图精致，色彩和谐，营造出一种时尚、优雅且富有艺术感的氛围。\"\n}"]},{"id":58,"type":"ImageLoader","pos":[-1491.4357793218967,-417.7115879826441],"size":[238.26918029785156,360.3518981933594],"flags":{},"order":0,"mode":4,"inputs":[{"label":"image","localized_name":"image","name":"image","type":"COMBO","widget":{"name":"image"}},{"label":"upload","localized_name":"upload","name":"upload","type":"IMAGEUPLOAD","widget":{"name":"upload"}}],"outputs":[{"label":"IMAGE","localized_name":"图像","name":"IMAGE","type":"IMAGE"},{"label":"MASK","localized_name":"遮罩","name":"MASK","type":"MASK"},{"label":"PATH","localized_name":"PATH","name":"PATH","type":"PATH","links":[87]}],"properties