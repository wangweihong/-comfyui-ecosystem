s":["真人风格，主角第一人称手机拍摄视角，镜头正对一个大胸穿着蕾丝情趣内衣紧身瑜伽裤\n的性感少妇.她坐在床上，145°侧对着镜头，偏过头看镜头，语气是声音成熟且诱惑，她有些无奈地一边\n接过镜头递过来的保险套一边说：“你爸不在家”，然后上身和头往镜头方向一伸，像是在质问镜头主角。说：“你就送我这个？”然后接着有些质问不耐烦地说：“嗯？！”一边眼睛往镜头主角下方盯了一会。\n角色看着镜头下方沉默了两秒，然后无奈又好笑地说：“哼！“，侧过头，爬上了床，一边爬一边说：\n“我就知道你小子没安好心..”，然后在床上一边保持着跪爬的姿势，一边回过头来，对着镜头主角宠溺地说：\n“行了，过来吧~”一边右手缓慢脱下内衣带子。"],"color":"#232","bgcolor":"#353"},{"id":4984,"type":"PrimitiveFloat","pos":[-4708.584185576676,4527.816749469324],"size":[270,58],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"值","name":"value","type":"FLOAT","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"浮点","name":"FLOAT","type":"FLOAT","links":[13354]}],"title":"视频长度","properties":{"cnr_id":"comfy-core","ver":"0.16.0","Node name for S&R":"PrimitiveFloat","ue_properties":{"widget_ue_connectable":{},"version":"7.7","input_ue_unconnectable":{}}},"widgets_values":[50]},{"id":4981,"type":"ResizeImageMaskNode","pos":[-4173.470482141361,3609.8125259089657],"size":[270,106],"flags":{},"order":19,"mode":0,"inputs":[{"localized_name":"输入","name":"input","type":"IMAGE,MASK","link":13415},{"localized_name":"调整类型","name":"resize_type","type":"COMFY_DYNAMICCOMBO_V3","widget":{"name":"resize_type"},"link":null},{"localized_name":"resize_type.longer_size","name":"resize_type.longer_size","type":"INT","widget":{"name":"resize_type.longer_size"},"link":null},{"localized_name":"缩放方法","name":"scale_method","type":"COMBO","widget":{"name":"scale_method"},"link":null}],"outputs":[{"localized_name":"已调整大小","name":"resized","type":"IMAGE","links":[13372]}],"properties":{"cnr_id":"comfy-core","ver":"0.16.0","Node name for S&R":"ResizeImageMaskNode","ue_properties":{"widget_ue_connectable":{},"version":"7.7","input_ue_unconnectable":{}}},"widgets_values":["scale longer dimension",1536,"lanczos"]},{"id":4993,"type":"VHS_LoadAudioUpload","pos":[-3849.270130659501,2187.275131458426],"size":[468.06839254152646,206.5087730224609],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"audio","name